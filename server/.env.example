# Server environment variables (example)

# MongoDB connection string
MONGODB_URI=mongodb://localhost:27017/campuscravings

# Server port
PORT=5000

# JWT secret used for password-based logins
JWT_SECRET=your_jwt_secret_here

# Firebase (if using Firebase auth)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Google Generative AI API key for embeddings & chat (required for AI features)
GOOGLE_API_KEY=your_google_api_key_here

# Optional: override the default GaLLa-based chat model name
AI_CHAT_MODEL=gemini-2.5-flash-lite

# Embedding model name (used by GoogleGenerativeAIEmbeddings)
GOOGLE_EMBEDDING_MODEL=gemini-embedding-001

# Temperature for chat model (0.0 - 1.0)
AI_CHAT_TEMPERATURE=0.4

# Chroma host/port (the server will attempt to start a local chroma instance under ./chromadb)
CHROMA_HOST=127.0.0.1
CHROMA_START_PORT=8000

# Cloudinary (images)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Razorpay (payments)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
